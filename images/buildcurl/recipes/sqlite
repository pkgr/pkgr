#!/usr/bin/env bash
set -euo pipefail

out_prefix="$1"
[[ "$VERSION" == "3.7.9" ]] || {
  echo "Unsupported SQLite version: $VERSION" >&2
  exit 2
}

echo "-> Building SQLite ${VERSION}..."

curl_flags=(--fail --silent --show-error --location --retry 3)
[[ "$TARGET" != "sles:12" ]] || curl_flags+=(-k)

curl "${curl_flags[@]}" "https://www.sqlite.org/sqlite-autoconf-3070900.tar.gz" \
  | tar xz --strip-components=1
./configure --prefix="$out_prefix"
make -j "${JOBS:-1}"
make install
echo "-----> Done."
